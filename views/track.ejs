<%- include('partials/header') %>

<div
  class="page-enter mx-auto max-w-3xl rounded-[1.5rem] border border-[#dce5de] bg-white p-6 shadow-[0_18px_50px_rgba(35,67,54,.06)] sm:p-10"
>
  <p class="text-sm font-semibold uppercase tracking-[.2em] text-[#e65f43]">
    Delivery visibility
  </p>
  <h1 class="mt-2 font-display text-4xl font-bold">Track an errand</h1>
  <p class="mt-3 text-[#61706a]">
    Enter the reference from your confirmation to see the latest status.
  </p>
  <form id="trackForm" class="mt-8 flex flex-col gap-3 sm:flex-row">
    <div class="flex-1">
      <input
        id="trackingId"
        class="w-full rounded-xl border border-[#cddbd2] bg-[#fbfcfa] px-4 py-3 outline-none focus:border-[#183d32]"
        placeholder="Tracking ID (RUN-ZA-######)"
      />
    </div>
    <div class="col-auto">
      <button
        class="rounded-xl bg-[#183d32] px-5 py-3 font-semibold text-white transition hover:bg-[#245847]"
      >
        Lookup
      </button>
    </div>
  </form>

  <div id="result" class="mt-8"></div>
</div>

<script>
  const escapeHtml = (value) =>
    String(value ?? "").replace(
      /[&<>"']/g,
      (char) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;",
        })[char],
    );

  const renderErrand = (errand) => {
    const result = document.getElementById("result");
    result.innerHTML = `
      <div class="rounded-2xl border border-[#dce5de] bg-[#fbfcfa] p-5">
        <p class="text-xs font-semibold uppercase tracking-[.2em] text-[#e65f43]">${escapeHtml(errand.id)}</p>
        <h3 class="mt-2 font-display text-2xl font-bold">${escapeHtml(errand.status)}</h3>
        <p class="mt-2 text-[#61706a]">${escapeHtml(errand.pickup_city)} → ${escapeHtml(errand.dropoff_city)}</p>
        <p class="mt-2 text-[#61706a]">Client: ${escapeHtml(errand.client_name)}${errand.runner_name ? ` · Runner: ${escapeHtml(errand.runner_name)}` : ""}</p>
        <p class="mt-2 text-[#61706a]">Delivery method: ${escapeHtml(errand.delivery_method)}</p>
        <p class="mt-2 text-[#61706a]">Reward: R ${escapeHtml(errand.reward_amount)}</p>
        <p class="mt-3 text-[#61706a]">Description: ${escapeHtml(errand.item_description)}</p>
      </div>
    `;
  };

  async function loadCurrentErrands() {
    const res = await fetch("/api/my/errands");
    const data = await res.json();
    const result = document.getElementById("result");
    if (data.status !== "success" || !data.data || data.data.length === 0) {
      result.innerHTML =
        '<div class="rounded-2xl border border-dashed border-[#dce5de] p-5 text-[#61706a]">No active errands to track yet.</div>';
      return;
    }

    result.innerHTML = data.data
      .map(
        (errand) => `
        <div class="mb-3 rounded-2xl border border-[#dce5de] bg-[#fbfcfa] p-4" data-track-errand="${escapeHtml(errand.id)}">
          <p class="text-xs font-semibold uppercase tracking-[.2em] text-[#e65f43]">${escapeHtml(errand.id)}</p>
          <h3 class="mt-2 font-display text-xl font-bold">${escapeHtml(errand.status)}</h3>
          <p class="mt-2 text-[#61706a]">${escapeHtml(errand.pickup_city)} → ${escapeHtml(errand.dropoff_city)}</p>
          <p class="mt-1 text-[#61706a]">Client: ${escapeHtml(errand.client_name)}${errand.runner_name ? ` · Runner: ${escapeHtml(errand.runner_name)}` : ""}</p>
          <p class="mt-1 text-[#61706a]">Reward: R ${escapeHtml(errand.reward_amount)}</p>
          <p class="mt-1 text-[#61706a]">Delivery: ${escapeHtml(errand.delivery_method)}</p>
          <div class="mt-4 border-t border-[#edf1ed] pt-4"><div class="flex gap-2"><input class="track-chat-input min-w-0 flex-1 rounded-xl border border-[#cddbd2] px-3 py-2 text-sm" placeholder="Message your ${data.role === "CLIENT" ? "runner" : "client"}..." /><button class="track-send-chat rounded-xl bg-[#183d32] px-3 py-2 text-sm font-semibold text-white">Send</button></div><div class="track-messages mt-3 space-y-1 text-sm text-[#61706a]"></div></div>
          ${data.role === "RUNNER" && errand.runner_id ? `<div class="mt-4 flex flex-wrap gap-2"><button class="track-status rounded-xl border border-[#cddbd2] px-3 py-2 text-xs font-semibold text-[#315b4b]" data-status="IN_TRANSIT">In transit</button><button class="track-status rounded-xl border border-[#cddbd2] px-3 py-2 text-xs font-semibold text-[#315b4b]" data-status="COMPLETED">Completed</button><button class="track-reopen rounded-xl border border-[#e65f43] px-3 py-2 text-xs font-semibold text-[#a8432d]">Put back online</button></div>` : ""}
        </div>
      `,
      )
      .join("");

    document.querySelectorAll("[data-track-errand]").forEach((card) => {
      const errandId = card.dataset.trackErrand;
      const messages = card.querySelector(".track-messages");
      const loadMessages = async () => {
        const response = await fetch(
          `/api/errands/${encodeURIComponent(errandId)}/messages`,
        );
        const messageData = await response.json();
        if (messageData.status === "success") {
          messages.innerHTML =
            messageData.data
              .map(
                (message) =>
                  `<p><strong>${escapeHtml(message.sender_name)}:</strong> ${escapeHtml(message.message_text)}</p>`,
              )
              .join("") || '<p class="text-[#9aa9a1]">No messages yet.</p>';
        }
      };
      card
        .querySelector(".track-send-chat")
        .addEventListener("click", async () => {
          const input = card.querySelector(".track-chat-input");
          if (!input.value.trim()) return;
          await fetch(`/api/errands/${encodeURIComponent(errandId)}/messages`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ message_text: input.value.trim() }),
          });
          input.value = "";
          loadMessages();
        });
      card
        .querySelectorAll(".track-status")
        .forEach((button) =>
          button.addEventListener("click", () =>
            updateTrackStatus(errandId, button.dataset.status),
          ),
        );
      card
        .querySelector(".track-reopen")
        ?.addEventListener("click", () =>
          updateTrackStatus(errandId, "PENDING"),
        );
      loadMessages();
      setInterval(loadMessages, 4000);
    });
  }

  async function updateTrackStatus(errandId, status) {
    const response = await fetch(
      `/api/errands/${encodeURIComponent(errandId)}/status`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status }),
      },
    );
    const data = await response.json();
    if (data.status !== "success")
      alert(data.message || "Could not update the request.");
    else loadCurrentErrands();
  }

  document.getElementById("trackForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = document.getElementById("trackingId").value.trim();
    if (!id) return;
    const res = await fetch(`/api/errands/${encodeURIComponent(id)}`);
    const data = await res.json();
    const result = document.getElementById("result");
    if (data.status !== "success") {
      result.innerHTML = `<div class="alert alert-warning">${data.message || JSON.stringify(data)}</div>`;
      return;
    }
    renderErrand(data.data);
  });

  loadCurrentErrands();
</script>

<%- include('partials/footer') %>
