<%- include('partials/header') %>

<div class="page-enter mx-auto max-w-6xl">
  <div class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-[.2em] text-[#e65f43]">
      Administration
    </p>
    <h1 class="mt-2 font-display text-4xl font-bold">
      People and verification
    </h1>
    <p class="mt-3 text-[#61706a]">
      Review registered clients and manage runner access to live requests.
    </p>
  </div>
  <div id="adminMessage" class="mb-6 hidden rounded-xl p-4 text-sm"></div>
  <section class="grid gap-6 lg:grid-cols-2">
    <div
      class="rounded-[1.5rem] border border-[#dce5de] bg-white p-6 shadow-[0_18px_50px_rgba(35,67,54,.06)]"
    >
      <div class="flex items-center justify-between">
        <h2 class="font-display text-2xl font-bold">Clients</h2>
        <span
          id="clientCount"
          class="rounded-full bg-[#edf5ef] px-3 py-1 text-xs font-semibold text-[#315b4b]"
          >0</span
        >
      </div>
      <div id="clients" class="mt-5 space-y-3"></div>
    </div>
    <div
      class="rounded-[1.5rem] border border-[#dce5de] bg-white p-6 shadow-[0_18px_50px_rgba(35,67,54,.06)]"
    >
      <div class="flex items-center justify-between">
        <h2 class="font-display text-2xl font-bold">Runners</h2>
        <span
          id="runnerCount"
          class="rounded-full bg-[#edf5ef] px-3 py-1 text-xs font-semibold text-[#315b4b]"
          >0</span
        >
      </div>
      <div id="runners" class="mt-5 space-y-3"></div>
    </div>
  </section>
</div>
<script>
  const clients = document.getElementById("clients");
  const runners = document.getElementById("runners");
  const message = document.getElementById("adminMessage");
  const escapeHtml = (value) =>
    String(value ?? "").replace(
      /[&<>"']/g,
      (char) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;",
        })[char],
    );
  const empty = (label) =>
    `<p class="rounded-xl bg-[#f7f8f3] p-4 text-sm text-[#87948d]">No ${label} registered yet.</p>`;

  async function loadUsers() {
    try {
      const response = await fetch("/api/admin/users");
      const data = await response.json();
      if (data.status !== "success") {
        showMessage(data.message || "Could not load users.", true);
        return;
      }
      document.getElementById("clientCount").textContent =
        data.data.clients.length;
      document.getElementById("runnerCount").textContent =
        data.data.runners.length;
      clients.innerHTML =
        data.data.clients
          .map(
            (user) =>
              `<div class="rounded-xl border border-[#edf1ed] p-4"><div class="flex justify-between gap-3"><div><p class="font-semibold">${escapeHtml(user.full_name)}</p><p class="mt-1 text-sm text-[#61706a]">${escapeHtml(user.email)}</p></div><span class="text-xs text-[#87948d]">Client</span></div><p class="mt-3 text-xs text-[#87948d]">${escapeHtml(user.phone)}</p></div>`,
          )
          .join("") || empty("clients");
      runners.innerHTML =
        data.data.runners
          .map(
            (user) =>
              `<div class="rounded-xl border border-[#edf1ed] p-4"><div class="flex flex-col justify-between gap-3 sm:flex-row"><div><p class="font-semibold">${escapeHtml(user.full_name)}</p><p class="mt-1 text-sm text-[#61706a]">${escapeHtml(user.email)} · ${escapeHtml(user.city)}</p><p class="mt-2 text-xs text-[#87948d]">ID: ${escapeHtml(user.id_number)}</p></div><button class="verification-toggle rounded-full px-3 py-2 text-xs font-semibold transition ${user.is_verified ? "bg-[#edf5ef] text-[#315b4b]" : "bg-[#fff4f0] text-[#a8432d]"}" data-user="${escapeHtml(user.id)}" data-value="${user.is_verified ? 0 : 1}">${user.is_verified ? "Verified · revoke" : "Pending · verify"}</button></div></div>`,
          )
          .join("") || empty("runners");
      document
        .querySelectorAll(".verification-toggle")
        .forEach((button) =>
          button.addEventListener("click", () => updateVerification(button)),
        );
    } catch (error) {
      showMessage("Could not connect to the admin user service.", true);
    }
  }
  async function updateVerification(button) {
    button.disabled = true;
    const response = await fetch(
      `/api/admin/runner/${encodeURIComponent(button.dataset.user)}/verification`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ is_verified: button.dataset.value }),
      },
    );
    const data = await response.json();
    if (data.status !== "success")
      showMessage(data.message || "Could not update verification.", true);
    else
      showMessage(
        Number(button.dataset.value)
          ? "Runner verified."
          : "Runner verification revoked.",
        false,
      );
    loadUsers();
  }
  function showMessage(text, isError) {
    message.textContent = text;
    message.className = `mb-6 rounded-xl p-4 text-sm ${isError ? "bg-[#fff4f0] text-[#a8432d]" : "bg-[#edf5ef] text-[#315b4b]"}`;
  }
  loadUsers();
</script>
<%- include('partials/footer') %>
