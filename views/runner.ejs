<%- include('partials/header') %>

<div class="page-enter mx-auto max-w-5xl">
  <div
    class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
  >
    <div>
      <p class="text-sm font-semibold uppercase tracking-[.2em] text-[#e65f43]">
        Runner workspace
      </p>
      <h1 class="mt-2 font-display text-4xl font-bold">Find your next route</h1>
      <p class="mt-3 text-[#61706a]">
        Live requests from verified runners in your pickup city.
      </p>
    </div>
    <span
      id="feedStatus"
      class="rounded-full bg-[#edf5ef] px-4 py-2 text-xs font-semibold text-[#315b4b]"
      >Connecting to your city...</span
    >
  </div>
  <div id="feed" class="grid gap-5"></div>
</div>

<script>
  const feed = document.getElementById("feed");
  const feedStatus = document.getElementById("feedStatus");
  const escapeHtml = (value) =>
    String(value ?? "").replace(
      /[&<>"']/g,
      (char) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;",
        })[char],
    );

  async function loadFeed() {
    const hasActiveChatDraft = [
      ...document.querySelectorAll(".chat-input"),
    ].some((input) => document.activeElement === input || input.value.trim());
    if (hasActiveChatDraft) return;

    const response = await fetch("/api/runner/feed");
    const data = await response.json();
    if (data.status !== "success") {
      feedStatus.textContent = data.message || "Feed unavailable";
      feed.innerHTML = `<div class="rounded-2xl border border-[#f0b6a5] bg-[#fff4f0] p-5 text-[#a8432d]">${escapeHtml(data.message || "Could not load the runner feed.")}</div>`;
      return;
    }
    feedStatus.textContent = `${data.runner_city} · live feed`;
    if (!data.data.length) {
      document.querySelectorAll("[data-errand]").forEach((card) => {
        clearInterval(card.chatRefresh);
      });
      feed.innerHTML =
        '<div class="rounded-2xl border border-[#dce5de] bg-white p-8 text-center text-[#61706a]">No open requests in your city right now. This feed updates automatically.</div>';
      return;
    }
    document.querySelectorAll("[data-errand]").forEach((card) => {
      clearInterval(card.chatRefresh);
    });
    feed.innerHTML = data.data
      .map(
        (errand) => `
      <article class="rounded-[1.5rem] border border-[#dce5de] bg-white p-6 shadow-[0_18px_50px_rgba(35,67,54,.06)]" data-errand="${escapeHtml(errand.id)}">
        <div class="flex flex-col justify-between gap-4 sm:flex-row"><div><p class="text-xs font-semibold uppercase tracking-wider text-[#87948d]">${escapeHtml(errand.id)}</p><h2 class="mt-2 font-display text-2xl font-bold">${escapeHtml(errand.pickup_city)} <span class="text-[#e65f43]">→</span> ${escapeHtml(errand.dropoff_city)}</h2></div><div class="rounded-2xl bg-[#edf5ef] px-5 py-3 sm:text-right"><p class="text-xs font-semibold uppercase tracking-wider text-[#61706a]">Reward</p><p class="font-display text-2xl font-bold text-[#183d32]">R ${escapeHtml(errand.reward_amount)}</p></div></div>
        <p class="mt-5 leading-7 text-[#61706a]">${escapeHtml(errand.item_description)}</p><p class="mt-2 text-sm text-[#87948d]">Delivery method: ${escapeHtml(errand.delivery_method)}</p>
        <div class="mt-6 border-t border-[#edf1ed] pt-5"><p class="mb-3 text-sm font-semibold">Ask a question before accepting</p><div class="flex gap-2"><input class="chat-input min-w-0 flex-1 rounded-xl border border-[#cddbd2] px-4 py-3 text-sm outline-none focus:border-[#183d32]" placeholder="Message the client..." /><button class="send-chat rounded-xl border border-[#cddbd2] px-4 py-3 text-sm font-semibold text-[#315b4b] transition hover:bg-[#edf5ef]">Send</button></div><div class="chat-messages mt-4 max-h-40 space-y-2 overflow-y-auto text-sm text-[#61706a]"></div></div>
        <button type="button" class="accept-errand mt-5 w-full rounded-xl bg-[#183d32] px-5 py-3.5 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-[#245847]" data-id="${escapeHtml(errand.id)}">Accept this errand</button>
        <button type="button" class="reopen-errand mt-3 w-full rounded-xl border border-[#e65f43] bg-white px-5 py-3.5 font-semibold text-[#a8432d] transition hover:bg-[#fff4f0]" data-id="${escapeHtml(errand.id)}">Put back online</button>
      </article>`,
      )
      .join("");
    document
      .querySelectorAll("[data-errand]")
      .forEach((card) => setupChat(card, card.dataset.errand));
    document
      .querySelectorAll(".accept-errand")
      .forEach((button) =>
        button.addEventListener("click", () => accept(button.dataset.id)),
      );
    document
      .querySelectorAll(".reopen-errand")
      .forEach((button) =>
        button.addEventListener("click", () => reopen(button.dataset.id)),
      );
  }

  async function setupChat(card, errandId) {
    const messages = card.querySelector(".chat-messages");
    const input = card.querySelector(".chat-input");
    const renderMessages = async () => {
      const response = await fetch(
        `/api/errands/${encodeURIComponent(errandId)}/messages`,
      );
      const data = await response.json();
      if (data.status === "success")
        messages.innerHTML =
          data.data
            .map(
              (message) =>
                `<p><strong class="text-[#183d32]">${escapeHtml(message.sender_name)}:</strong> ${escapeHtml(message.message_text)}</p>`,
            )
            .join("") || '<p class="text-[#9aa9a1]">No questions yet.</p>';
    };
    card.querySelector(".send-chat").addEventListener("click", async () => {
      const message = input.value.trim();
      if (!message) return;
      await fetch(`/api/errands/${encodeURIComponent(errandId)}/messages`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message_text: message }),
      });
      input.value = "";
      renderMessages();
    });
    await renderMessages();
    if (!card.isConnected) return;
    card.chatRefresh = setInterval(renderMessages, 4000);
  }

  async function reopen(errandId) {
    const response = await fetch(
      `/api/errands/${encodeURIComponent(errandId)}/status`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status: "PENDING" }),
      },
    );
    const data = await response.json();
    alert(data.message || "Request reopened.");
    await loadFeed();
  }

  async function accept(errandId) {
    const response = await fetch(
      `/api/errands/${encodeURIComponent(errandId)}/accept`,
      { method: "POST" },
    );
    const data = await response.json();
    if (!data.status || data.status !== "success")
      alert(data.message || "This errand is no longer available.");
    await loadFeed();
  }
  loadFeed();
  setInterval(() => {
    if (document.activeElement?.classList.contains("chat-input")) return;
    loadFeed();
  }, 5000);
</script>

<%- include('partials/footer') %>
