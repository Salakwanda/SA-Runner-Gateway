<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Create account | SA Runner Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script><script>tailwind.config={theme:{extend:{fontFamily:{sans:["DM Sans","sans-serif"],display:["Space Grotesk","sans-serif"]}}}};</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" /><link rel="stylesheet" href="/style.css" />
  </head>
  <body class="min-h-screen bg-[#f7f8f3] font-sans text-[#15231f]"><main class="mx-auto max-w-2xl px-5 py-10 lg:px-8"><div class="rounded-[2rem] border border-[#dce5de] bg-white p-7 shadow-[0_24px_80px_rgba(35,67,54,.10)] sm:p-12"><a href="/" class="font-display text-lg font-bold"><span class="mr-2 inline-block h-2.5 w-2.5 rounded-full bg-[#e65f43] align-middle"></span>SA Runner Gateway</a><div class="mt-12"><p class="text-sm font-semibold uppercase tracking-[.2em] text-[#e65f43]">Join the network</p><h1 class="mt-2 font-display text-4xl font-bold">Create your account</h1><p class="mt-3 text-[#61706a]">Choose your role and get moving.</p><% if (error) { %><div class="mt-6 rounded-xl border border-[#f0b6a5] bg-[#fff4f0] px-4 py-3 text-sm text-[#a8432d]"><%= error %></div><% } %><form class="mt-8 space-y-5" method="post" action="/register"><fieldset><legend class="mb-3 text-sm font-semibold">I want to join as a</legend><div class="grid grid-cols-2 gap-3"><label class="cursor-pointer"><input class="peer sr-only" type="radio" name="role" value="CLIENT" <%= selectedRole === 'CLIENT' ? 'checked' : '' %> /><span class="block rounded-2xl border border-[#dce5de] px-4 py-4 text-center text-sm font-semibold transition peer-checked:border-[#183d32] peer-checked:bg-[#edf5ef]">Client</span></label><label class="cursor-pointer"><input class="peer sr-only" type="radio" name="role" value="RUNNER" <%= selectedRole === 'RUNNER' ? 'checked' : '' %> /><span class="block rounded-2xl border border-[#dce5de] px-4 py-4 text-center text-sm font-semibold transition peer-checked:border-[#183d32] peer-checked:bg-[#edf5ef]">Runner</span></label></div></fieldset><label class="block text-sm font-semibold">Full name<input name="full_name" value="<%= formData.fullName || '' %>" required class="mt-2 w-full rounded-xl border border-[#cddbd2] bg-[#fbfcfa] px-4 py-3 font-normal outline-none focus:border-[#183d32]" /></label><div class="grid gap-5 sm:grid-cols-2"><label class="block text-sm font-semibold">Email<input type="email" name="email" value="<%= formData.email || '' %>" required class="mt-2 w-full rounded-xl border border-[#cddbd2] bg-[#fbfcfa] px-4 py-3 font-normal outline-none focus:border-[#183d32]" /></label><label class="block text-sm font-semibold">Phone<input name="phone" value="<%= formData.phone || '' %>" required class="mt-2 w-full rounded-xl border border-[#cddbd2] bg-[#fbfcfa] px-4 py-3 font-normal outline-none focus:border-[#183d32]" /></label></div><label class="block text-sm font-semibold">Password<input type="password" name="password" minlength="8" required class="mt-2 w-full rounded-xl border border-[#cddbd2] bg-[#fbfcfa] px-4 py-3 font-normal outline-none focus:border-[#183d32]" /></label><div class="grid gap-5 sm:grid-cols-2"><label class="block text-sm font-semibold">City <span class="font-normal text-[#87948d]">(runners)</span><input name="city" value="<%= formData.city || '' %>" class="mt-2 w-full rounded-xl border border-[#cddbd2] bg-[#fbfcfa] px-4 py-3 font-normal outline-none focus:border-[#183d32]" /></label><label class="block text-sm font-semibold">ID number <span class="font-normal text-[#87948d]">(runners)</span><input name="id_number" value="<%= formData.idNumber || '' %>" class="mt-2 w-full rounded-xl border border-[#cddbd2] bg-[#fbfcfa] px-4 py-3 font-normal outline-none focus:border-[#183d32]" /></label></div><button class="w-full rounded-xl bg-[#183d32] px-5 py-4 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-[#245847]" type="submit">Create account</button></form><p class="mt-6 text-center text-sm text-[#61706a]">Already registered? <a class="font-semibold text-[#183d32] underline" href="/login">Log in</a></p></div></div></main></body>
</html>