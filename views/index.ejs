<%- include('partials/header') %>

<div class="page-enter">
  <section class="grid items-end gap-10 pb-14 pt-5 lg:grid-cols-[1.25fr_.75fr]">
    <div class="max-w-3xl">
      <p
        class="mb-5 text-sm font-semibold uppercase tracking-[.2em] text-[#e65f43]"
      >
        The local delivery network
      </p>
      <h1
        class="font-display text-5xl font-bold leading-[1.02] tracking-tight sm:text-7xl"
      >
        Every errand,<br /><span class="text-[#e65f43]">handled.</span>
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-8 text-[#61706a]">
        A trusted bridge between people who need a hand and runners who know the
        city by heart.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="<%= currentUser ? '/create' : '/register' %>"
          class="rounded-full bg-[#183d32] px-6 py-3.5 font-semibold text-white transition hover:-translate-y-1 hover:bg-[#245847]"
          ><%= currentUser ? 'Request an errand' : 'Create an account' %> <span class="ml-2">→</span></a
        ><a
          href="/track"
          class="rounded-full border border-[#cddbd2] px-6 py-3.5 font-semibold text-[#315b4b] transition hover:bg-white"
          >Track a delivery</a
        >
      </div>
    </div>
    <% if (currentUser) { %><div class="rise-in relative rounded-[2rem] bg-[#e5eee5] p-7 lg:mb-3">
      <div
        class="absolute right-6 top-6 h-3 w-3 rounded-full bg-[#e65f43]"
      ></div>
      <p class="text-sm font-semibold text-[#61706a]">Live network pulse</p>
      <div class="mt-12 font-display text-6xl font-bold">
        <%= totalErrands %>
      </div>
      <p class="mt-2 text-[#61706a]">errands moving through the gateway</p>
      <div class="mt-8 h-2 overflow-hidden rounded-full bg-white">
        <div class="h-full w-3/4 rounded-full bg-[#e65f43]"></div>
      </div>
      <p
        class="mt-3 text-xs font-semibold uppercase tracking-wider text-[#74827b]"
      >
        <%= verifiedRunners %> verified runners ready
      </p>
    </div><% } else { %><div class="rise-in relative rounded-[2rem] bg-[#e5eee5] p-7 lg:mb-3"><p class="text-sm font-semibold text-[#61706a]">A better way to move locally</p><h2 class="mt-10 max-w-xs font-display text-3xl font-bold leading-tight">Trusted people. Clear updates. Less friction.</h2><div class="mt-10 flex gap-2"><span class="h-2 w-16 rounded-full bg-[#e65f43]"></span><span class="h-2 w-8 rounded-full bg-[#183d32]"></span><span class="h-2 w-3 rounded-full bg-[#9ab5a3]"></span></div></div><% } %>
  </section>
  <% if (currentUser) { %><section class="grid gap-4 border-t border-[#dce5de] py-8 sm:grid-cols-3">
    <div>
      <div class="font-display text-3xl font-bold"><%= totalUsers %></div>
      <p class="mt-1 text-sm text-[#74827b]">People in the network</p>
    </div>
    <div>
      <div class="font-display text-3xl font-bold"><%= verifiedRunners %></div>
      <p class="mt-1 text-sm text-[#74827b]">Verified local runners</p>
    </div>
    <div>
      <div class="font-display text-3xl font-bold"><%= totalErrands %></div>
      <p class="mt-1 text-sm text-[#74827b]">Errands placed so far</p>
    </div>
  </section><% } %>
</div>

<%- include('partials/footer') %>
